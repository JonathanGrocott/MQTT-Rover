{
  "name": "@mqtt-rover/client",
  "productName": "MQTT Rover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "vite build --config electron/vite.main.config.ts && vite build --config electron/vite.preload.config.ts",
    "electron:dev": "npm run electron:compile && concurrently -k -s first \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env MQTT_ROVER_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:package": "npm run electron:build && electron-forge package",
    "electron:make": "npm run electron:build && electron-forge make"
  },
  "dependencies": {
    "@mqtt-rover/protocol": "file:../../packages/protocol",
    "@mqtt-rover/sparkplug": "file:../../packages/sparkplug",
    "mqtt": "^5.14.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  }
}
